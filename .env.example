NETSENTINEL_DATABASE_URL=sqlite:///./netsentinel.db
NETSENTINEL_BIND_HOST=127.0.0.1
NETSENTINEL_BIND_PORT=8000
# Set true only behind a trusted HTTPS reverse proxy.
NETSENTINEL_SECURE_COOKIES=false
# Optional Phase 2 outbound alert webhook. Use an HTTPS endpoint you control.
# Configure on the server, then explicitly enable notifications in Settings.
NETSENTINEL_WEBHOOK_URL=
NETSENTINEL_WEBHOOK_TOKEN=
